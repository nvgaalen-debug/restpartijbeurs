# Beveiligingsheaders voor de website (Netlify leest dit bestand automatisch).
# - Scripts alleen uit onze eigen bestanden (geen code in de pagina, niets van buiten).
# - De pagina praat alleen met onze eigen server; foto's alleen van onze eigen server.
# - style-src 'unsafe-inline' is nodig voor style-attributen in de schermen; dat laat geen code uitvoeren.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: geolocation=(), microphone=(self), camera=(), payment=(), usb=(), interest-cohort=()

# Opmaak en scripts: altijd controleren of er een nieuwe versie is, zodat nooit een oude
# en een nieuwe versie door elkaar gebruikt worden na een update
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/app.css
  Cache-Control: public, max-age=0, must-revalidate

# HTML en versie-bestand nooit uit een oude kopie halen: zo zien telefoons een update direct
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/api-tester.html
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
